# Salin ke .env — file .env TIDAK di-commit ke GitHub
# cp .env.example .env

WEB_PORT=3000
ROBOT_HOST=127.0.0.1
ROBOT_BRIDGE_PORT=8765

# Token yang sama dengan api_token di robot.config.ini
ROBOT_API_KEY=GANTI_DENGAN_TOKEN_ACAK_PANJANG

# Kunci untuk memanggil API website dari browser/Postman (header X-API-Key)
WEB_API_KEY=GANTI_DENGAN_KUNCI_WEB_TERPISAH
